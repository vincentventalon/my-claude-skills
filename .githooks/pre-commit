#!/bin/bash
# Validates the marketplace, the plugin at the root and every skill before a commit.
# Offline, no model call. Enabled with `git config core.hooksPath .githooks`.
set -e
cd "$(git rev-parse --show-toplevel)"

# Every skills/<category>/<name>/SKILL.md: a front matter whose name is its folder (npx skills installs it under that name).
python3 dev/check_skills.py

if ! command -v claude >/dev/null 2>&1; then
  echo "pre-commit: \`claude\` not found, skipping the plugin validation" >&2
  exit 0
fi

# The marketplace and the plugin at the root (.claude-plugin/plugin.json, skills/).
claude plugin validate . --strict
# Every `source` of the marketplace (a missing folder passed unnoticed before, 2026-11-02).
for d in $(python3 -c 'import json;print(" ".join(p["source"] for p in json.load(open(".claude-plugin/marketplace.json"))["plugins"]))'); do
  claude plugin validate "$d" --strict
done
